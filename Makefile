# SPDX-License-Identifier: Apache-2.0

CARGO ?= cargo
# Pinned nightly for Miri: rustc 1.101.0-nightly (6f5da406b 2026-10-10).
MIRI_TOOLCHAIN ?= nightly-2026-10-11

.PHONY: fmt fmt-check lint doc test netem loom loom-full sim sim-arch unsafe-report bench measure timing-build-check miri miri-sys-log-buffer miri-sys-rest miri-ffi build-release libkaryos libkaryos-static-check libkaryos-copies-check libkaryos-testkit libkaryos-release-check abi-manifest-check header-check header test-hooks-absent-check deny deps-inventory deps-check shipped-graph-check control-plane-graph-check codec-derive-check sbe-graph-check raft-eval lint-sync changelog-check lint-linux pre-push

fmt:
	$(CARGO) fmt --all

fmt-check:
	$(CARGO) fmt --all -- --check

lint:
	$(CARGO) clippy --workspace --all-targets --locked -- -D warnings

# Clippy for Linux with every feature, from any host: the Linux-only code
# (cfg(target_os = "linux")) is checked before a push, not first in Docker.
# Needs `rustup target add aarch64-unknown-linux-gnu`.
lint-linux:
	$(CARGO) clippy --workspace --all-targets --all-features --locked --target aarch64-unknown-linux-gnu -- -D warnings

doc:
	RUSTDOCFLAGS="-D warnings" $(CARGO) doc --workspace --no-deps --locked

test:
	$(CARGO) test --workspace --locked

loom:
	RUSTFLAGS="--cfg loom" $(CARGO) test -p karyos-sys --release --locked --test 'loom_*'

# loom plus the slow models marked #[ignore] (about 11 minutes more). Hosted
# CI is off, so this is a merge gate: a PR that touches the counters seqlock
# or its layout (crates/*/src/counters*, crates/karyos-sys/tests/loom_counters.rs)
# cites a green `make loom-full` run on its exact head as review evidence
# (coordinator decision, ACS 12607). It is also a release gate, run at every
# release head (RELEASING.md).
loom-full:
	RUSTFLAGS="--cfg loom" $(CARGO) test -p karyos-sys --release --locked --test 'loom_*' -- --include-ignored

sim:
	@start=$$(date +%s); \
	KARYOS_SIM_SEED= KARYOS_SIM_SEEDS=2000 $(CARGO) test -p karyos-sim --release --locked --test scenarios --test uring_model; status=$$?; \
	end=$$(date +%s); \
	printf 'simulator sweep elapsed: %s seconds (fixed seeds 1..=2000)\n' "$$((end - start))"; \
	exit $$status

# aarch64 native against emulated linux/amd64 (issue #11): timings and
# outcomes only, never a gate; an emulated run that cannot complete is
# reported as not verifiable on this host.
sim-arch:
	scripts/sim-arch-compare.sh

# The workspace's `unsafe` surface from the source (issue #11): a report,
# never a gate.
unsafe-report:
	scripts/unsafe-report.sh

bench:
	$(CARGO) run -p karyos-bench --release --locked -- $(BENCH_ARGS)

measure:
	scripts/measure.sh $(MEASURE_ARGS)

# The bench binary built as measure.sh builds it must be a timing build
# (no alloc-count; an --all-features build never is one).
timing-build-check:
	$(CARGO) build -p karyos-bench --release --locked
	test "$$($${CARGO_TARGET_DIR:-target}/release/karyos-bench build-info)" = "build timing"
	! $${CARGO_TARGET_DIR:-target}/release/karyos-bench measure --plan synthetic --plan-only >/dev/null 2>&1
	$${CARGO_TARGET_DIR:-target}/release/karyos-bench measure --plan synthetic --plan-only 2>&1 | grep -q "needs the synthetic build"

# Miri in three parts that CI runs as separate jobs (karyos#161): the full
# run takes about 10 h on a shared Linux host, beyond one job's 6 h limit.
miri: miri-sys-log-buffer miri-sys-rest miri-ffi

miri-sys-log-buffer:
	$(CARGO) +$(MIRI_TOOLCHAIN) miri test -p karyos-sys --lib --locked log_buffer::

miri-sys-rest:
	$(CARGO) +$(MIRI_TOOLCHAIN) miri test -p karyos-sys --lib --locked -- --skip log_buffer::

miri-ffi:
	$(CARGO) +$(MIRI_TOOLCHAIN) miri test -p karyos-ffi --locked

build-release:
	RUSTFLAGS="-D warnings" $(CARGO) build --workspace --release --locked

# libkaryos packaged for the language bindings (include, lib, pkg-config,
# the conformance suite and a MANIFEST) into LIBKARYOS_DIR, by default
# target/libkaryos (quantstratum-docs: karyos/design/bindings-plan.md, B1).
# Not part of pre-push.
libkaryos:
	CARGO="$(CARGO)" scripts/package-libkaryos.sh $(LIBKARYOS_DIR)

# A C program linked statically through the package's karyos-static.pc.
# It compiles C, so it is not part of pre-push.
libkaryos-static-check: libkaryos
	scripts/check-libkaryos-static.sh $(LIBKARYOS_DIR)

# Two copies of the package's library in one process each refuse the
# other's handles (C-LINKAGE). It compiles C, so it is not part of
# pre-push.
libkaryos-copies-check: libkaryos
	scripts/check-libkaryos-copies.sh $(LIBKARYOS_DIR)

# The C header's ABI manifest (sizes, offsets, constants) matches the
# committed one, crates/karyos-ffi/abi/manifest.txt: a layout change
# without a new ABI version fails (owner item 48; karyos#700).
abi-manifest-check:
	scripts/check-abi-manifest.sh

# The C header is generated by cbindgen 0.29.4 (a maintainer tool, not a
# dependency; karyos#697): header-check regenerates it and fails on any
# difference, header rewrites it.
header-check:
	scripts/check-header.sh

header:
	scripts/check-header.sh --write

# The release library has none of the conformance test kit's fault hook
# (karyos-ffi feature `test-hooks`): no `karyos_test_` symbol and none of
# its code (karyos#699). After build-release, whose libraries it reads.
# No shipped build enables the archival test signer (karyos-archive
# feature `test-hooks`, the ed25519-dalek admission's tests-only
# `SigningKey`; karyos#973).
test-hooks-absent-check: build-release
	scripts/check-test-hooks-absent.sh
	scripts/check-archive-test-hooks-absent.sh

# The conformance test kit beside the package: karyosd from the same
# commit, for the suite's archive-replay scenarios (Linux only). Not part
# of the release package (owner item 44), and not part of pre-push.
libkaryos-testkit: libkaryos
	CARGO="$(CARGO)" scripts/package-testkit.sh $(LIBKARYOS_DIR)

# The release artifacts of libkaryos and karyosd, built as two separate
# archives from a clean tree (scripts/release-libkaryos.sh), checked
# against their SHA256SUMS, and the conformance suite run against the
# libkaryos archive itself, not a build tree (scripts/conformance-package.sh;
# owner item 44, karyos#700). Signs and publishes nothing: signing
# (scripts/sign-release.sh) and publication are the release key
# custodian's steps. Into RELEASE_ARTIFACTS_DIR, by default
# target/release-artifacts. Needs a clean git tree; not part of pre-push.
RELEASE_ARTIFACTS_DIR ?= $(CURDIR)/target/release-artifacts
libkaryos-release-check:
	rm -rf $(RELEASE_ARTIFACTS_DIR)
	CARGO="$(CARGO)" scripts/release-libkaryos.sh $(RELEASE_ARTIFACTS_DIR)
	set -- $(RELEASE_ARTIFACTS_DIR)/libkaryos-*.tar.gz && [ $$# -eq 1 ] && [ -f "$$1" ] && \
		CARGO="$(CARGO)" scripts/conformance-package.sh "$$1"

deny:
	$(CARGO) deny check

deps-inventory:
	python3 scripts/dependency-inventory.py deps/dependency-inventory.json

deps-check:
	@tmp=$$(mktemp) && python3 scripts/dependency-inventory.py $$tmp && diff -u deps/dependency-inventory.json $$tmp; status=$$?; rm -f $$tmp; exit $$status

# The control-plane component's graph stays out of the agent's and the
# default build's, with no native crypto (karyos#708; the agent HTTP
# stack's admission record, conditions 3 and 4).
control-plane-graph-check:
	scripts/check-control-plane-graph.sh

# The object storage client stays out of every data-path graph and the
# default build's, with no native crypto (karyos#965; the object storage
# admission record, conditions 3 and 4).
tiering-graph-check:
	scripts/check-tiering-graph.sh

# The codec derive's crates stay compiler-side and add no `syn` major
# (karyos#661; owner decision 2026-10-21 item 15).
codec-derive-check:
	scripts/check-codec-derive-graph.sh

# The SBE boundary (karyos#631; the IronSBE admission record's condition
# 2): IronSBE only in karyos-sbe, none of its excluded crates anywhere, and
# karyos-feed never depending on karyos-sbe; with its negative controls.
sbe-graph-check:
	CARGO="$(CARGO)" python3 scripts/check-sbe-graph.py
	CARGO="$(CARGO)" scripts/check-sbe-graph-selftest.sh

# No Raft candidate and not the evaluation crate in any shipped graph, and
# no Tokio outside karyos-control's (cargo tree, every target, default and every feature; with
# negative controls): the evaluation-only admission's
# conditions 2 and 3 (karyos#677).
shipped-graph-check:
	CARGO="$(CARGO)" scripts/check-shipped-graph.sh
	CARGO="$(CARGO)" scripts/check-shipped-graph-selftest.sh
# The Raft candidates' evaluation workspace (eval/raft-candidates, its own
# lockfile): format, clippy, docs and tests, with the bundled protoc 3.9.0
# that raft-proto's build script needs (karyos#678).
raft-eval:
	CARGO="$(CARGO)" eval/raft-candidates/check.sh
lint-sync:
	scripts/check-lint-sync.sh

# Each fragment of changelog.d/ starts with exactly one section header.
changelog-check:
	scripts/changelog-assemble.sh --check

# The network fault tests under tc netem in Linux Docker (W6). Needs
# Docker with NET_ADMIN; not part of pre-push. KARYOS_NETEM sets the
# profile.
netem:
	scripts/netem-test.sh

pre-push: fmt-check changelog-check lint-sync deps-check shipped-graph-check control-plane-graph-check tiering-graph-check header-check codec-derive-check sbe-graph-check abi-manifest-check lint lint-linux doc test raft-eval loom build-release test-hooks-absent-check timing-build-check
