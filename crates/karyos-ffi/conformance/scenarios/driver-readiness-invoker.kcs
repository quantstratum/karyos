# A driver's readiness over the C ABI (R-CORE-35, karyos#794), driven by
# its caller: starting until the host declares its startup complete, then
# ready. The codes are the admission probe's: KARYOS_READINESS_STARTING 1,
# _READY 2, and KARYOS_READINESS_REASON_NONE 0; the reserved word is 0.
format 1
id driver.readiness.invoker
abi 0.1
covers "driver readiness"

call karyos_driver_create
expect KARYOS_OK driver=$driver
call karyos_driver_readiness driver=$driver
expect KARYOS_OK state=1 reason=0 reserved=0 tail="intact"
call karyos_driver_startup_complete driver=$driver
expect KARYOS_OK complete=1
call karyos_driver_readiness driver=$driver
expect KARYOS_OK state=2 reason=0 reserved=0 tail="intact"
call karyos_driver_startup_complete driver=$driver
expect KARYOS_OK complete=1
call karyos_driver_close driver=$driver
expect KARYOS_OK
