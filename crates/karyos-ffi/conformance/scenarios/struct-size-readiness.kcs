# karyos_readiness (ABI 0.1.3) is an output whose size the caller sets: a
# size below its first version's 24 bytes is KARYOS_E_INVALID_ARGUMENT
# with nothing written, and a newer caller's larger struct gets the fields
# this version knows, with its tail untouched (SPEC.md §10.2).
format 1
id struct.size.readiness
abi 0.1
covers "struct sizes of another minor version"

call karyos_driver_create
expect KARYOS_OK driver=$driver
call karyos_driver_readiness driver=$driver size=0
expect KARYOS_E_INVALID_ARGUMENT tail="intact"
call karyos_driver_readiness driver=$driver size=20
expect KARYOS_E_INVALID_ARGUMENT tail="intact"
call karyos_driver_readiness driver=$driver size=24
expect KARYOS_OK state=1 reason=0 reserved=0 tail="intact"
call karyos_driver_readiness driver=$driver size=40
expect KARYOS_OK state=1 reason=0 reserved=0 tail="intact"
call karyos_driver_close driver=$driver
expect KARYOS_OK
