# What a replay request is refused for: an unknown recording (the
# Archive's code 2), an unknown replay to stop (code 3), and a rate and
# scale that do not match, refused before any request goes out.
format 2
id op.replay.refused
abi 0.1
covers "archive replays"
since B3
feature archive-replay

op archive.connect client=$archive_client
expect ok archive=$archive
op archive.replay archive=$archive recording=999 target_stream_id=1041
expect status=refused code=2
op archive.stop_replay archive=$archive replay=777
expect status=refused code=3
op archive.replay archive=$archive recording=$recording target_stream_id=1041 rate="full" scale_ppm=5
expect status=invalid_argument
op archive.close archive=$archive
expect ok
op archive.close archive=$archive
expect ok
