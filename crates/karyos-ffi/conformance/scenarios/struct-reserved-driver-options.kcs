# A reserved field is zero in every version that does not define it, so a
# later minor version can give it a meaning: karyos_driver_options with a
# nonzero reserved answers KARYOS_E_INVALID_ARGUMENT and creates nothing
# (SPEC.md §10.2, §13, C ABI boundary).
format 1
id struct.reserved.driver.options
abi 0.1
covers "struct sizes of another minor version"

call karyos_driver_create reserved=1
expect KARYOS_E_INVALID_ARGUMENT
call karyos_driver_create reserved=4294967295
expect KARYOS_E_INVALID_ARGUMENT
call karyos_driver_create reserved=0
expect KARYOS_OK driver=$driver
call karyos_driver_close driver=$driver
expect KARYOS_OK
