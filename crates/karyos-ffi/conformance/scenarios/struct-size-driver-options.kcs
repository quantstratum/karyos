# A struct's size field says which header built it. The 0.1.0 size of
# karyos_driver_options (56 bytes) is the smallest accepted: below it the
# call answers KARYOS_E_INVALID_ARGUMENT and creates nothing, and at it
# the fields later versions append take their defaults (0.1.3's
# startup_timeout_ns: 30 s; 0.1.4's network: off; 0.1.5's
# max_stream_bytes: no cap).
# A newer caller's larger struct is read by this version's prefix, and
# the call succeeds as at that size (SPEC.md §10.2, §13, C ABI boundary).
format 1
id struct.size.driver.options
abi 0.1
covers "struct sizes of another minor version"

call karyos_driver_create size=0
expect KARYOS_E_INVALID_ARGUMENT
call karyos_driver_create size=52
expect KARYOS_E_INVALID_ARGUMENT
call karyos_driver_create size=56
expect KARYOS_OK driver=$exact
call karyos_driver_close driver=$exact
expect KARYOS_OK
call karyos_driver_create size=72
expect KARYOS_OK driver=$older
call karyos_driver_close driver=$older
expect KARYOS_OK
call karyos_driver_create size=80
expect KARYOS_OK driver=$current
call karyos_driver_close driver=$current
expect KARYOS_OK
call karyos_driver_create size=88
expect KARYOS_OK driver=$newer
call karyos_driver_close driver=$newer
expect KARYOS_OK
