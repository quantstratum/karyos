# A second close after a successful one is ok and closes nothing more
# (FORMAT.md, Close; BIND-GO-CLOSE), where the C ABI answers
# KARYOS_E_CLOSED (handle.double.close). It runs on the runner's driver.
format 2
id op.double.close
abi 0.1
covers "double close"
since B1

op client.connect driver=$driver
expect ok client=$client
op publication.add client=$client stream_id=1
expect ok publication=$publication
op subscription.add client=$client stream_id=1
expect ok subscription=$subscription
op publication.close publication=$publication
expect ok
op publication.close publication=$publication
expect ok
op subscription.close subscription=$subscription
expect ok
op subscription.close subscription=$subscription
expect ok
op client.close client=$client
expect ok
op client.close client=$client
expect ok
