# A timed offer at the time karyos_clock_now reads passes the lane's
# schedule checks and meets the next one (no subscriber: the suite has
# none). A plain offer on a timed lane, a time past the lane's horizon and
# a timed offer on a lane that is not timed are refused with typed statuses
# (SPEC.md §13, C ABI boundary; quantstratum-docs:
# karyos/design/ffi-gap-analysis.md §6, F7a-3). An unknown clock domain is
# an invalid argument, and nothing is written.
format 1
id publication.timed.offer
abi 0.1
covers "typed status codes"

call karyos_driver_create
expect KARYOS_OK driver=$driver
call karyos_driver_add_stream driver=$driver stream_id=7 schedule_capacity=4
expect KARYOS_OK
call karyos_driver_add_stream driver=$driver stream_id=8
expect KARYOS_OK
call karyos_driver_start driver=$driver
expect KARYOS_OK
call karyos_driver_connect driver=$driver
expect KARYOS_OK client=$client
call karyos_client_add_publication client=$client stream_id=7
expect KARYOS_OK publication=$timed
call karyos_client_add_publication client=$client stream_id=8
expect KARYOS_OK publication=$plain
call karyos_clock_now domain=0
expect KARYOS_OK now=$now
call karyos_publication_offer_at publication=$timed payload="x" tx_time=$now
expect KARYOS_E_NOT_CONNECTED
call karyos_publication_offer publication=$timed payload="x"
expect KARYOS_E_INVALID_SCHEDULE
call karyos_publication_offer_at publication=$timed payload="x" tx_time=9223372036854775807
expect KARYOS_E_INVALID_SCHEDULE
call karyos_publication_offer_at publication=$plain payload="x" tx_time=$now
expect KARYOS_E_INVALID_SCHEDULE
call karyos_clock_now domain=7
expect KARYOS_E_INVALID_ARGUMENT
call karyos_client_close client=$client
expect KARYOS_OK
call karyos_driver_close driver=$driver
expect KARYOS_OK
