# A timed lane of a driver in another process (owner item 65; SPEC.md §13,
# C ABI boundary; FORMAT.md, Remote driver): the runner's karyosd makes
# the network publications of stream 25 timed, and a subscription on the
# loopback endpoint receives them. A timed offer half a second ahead is
# delivered, and not before its time; a plain offer on the timed lane,
# a time below the lane's last, one past its horizon and a timed offer on
# a lane that is not timed are refused with typed statuses.
format 2
id publication.timed.offer
abi 0.1
covers "typed status codes"
since B3
feature remote-driver
feature image-wait

op subscription.add client=$remote_client stream_id=25 uri=$loopback_uri
expect ok subscription=$reading
op publication.add client=$remote_client stream_id=25 uri=$loopback_uri
expect ok publication=$timed
op subscription.await_image subscription=$reading
expect ok images=1
op publication.offer_at publication=$timed payload="timed" delay_ns=500000000
expect ok tx_time=$at
op subscription.poll subscription=$reading limit=8 until=1 not_before=$at
expect ok delivered=1 last="timed"
op publication.offer publication=$timed payload="plain"
expect status=invalid_schedule
op publication.offer_at publication=$timed payload="back" tx_time=1
expect status=invalid_schedule
op publication.offer_at publication=$timed payload="far" delay_ns=3600000000000
expect status=invalid_schedule
op publication.add client=$remote_client stream_id=26
expect ok publication=$untimed
op publication.offer_at publication=$untimed payload="x" delay_ns=0
expect status=invalid_schedule
op publication.close publication=$untimed
expect ok
op publication.close publication=$timed
expect ok
op subscription.close subscription=$reading
expect ok
