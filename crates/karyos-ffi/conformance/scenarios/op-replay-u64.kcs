# The uint64 arguments of a replay past the signed range, as a runner
# parses and passes them: the length 2^64 - 1 is the ABI's "to the end",
# so the replay delivers the whole recording; a position of 2^63 and a
# length of 2^63 lie past the recording's end, and the Archive refuses
# both as an invalid request (code 4). Arguments only: of the results,
# only handles cross 2^63, about half of them (FORMAT.md, Values).
format 2
id op.replay.u64
abi 0.1
covers "archive replays"
since B3
feature archive-replay

op archive.connect client=$archive_client
expect ok archive=$archive
op archive.replay archive=$archive recording=$recording target_stream_id=1041 length=18446744073709551615
expect ok replay=$replay session=$session
op replay.subscribe client=$archive_client stream_id=1041 session=$session
expect ok subscription=$subscription
op subscription.poll_to_end subscription=$subscription
expect ok delivered=10 last="r9"
op subscription.end subscription=$subscription
expect ok reason="end_of_stream" position=$recording_end
op subscription.close subscription=$subscription
expect ok
op archive.replay archive=$archive recording=$recording target_stream_id=1041 position=9223372036854775808
expect status=refused code=4
op archive.replay archive=$archive recording=$recording target_stream_id=1041 length=9223372036854775808
expect status=refused code=4
op archive.close archive=$archive
expect ok
