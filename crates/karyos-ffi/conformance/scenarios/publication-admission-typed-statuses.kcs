# A publication's network admission state (owner item 7, karyos#637; ABI
# 0.1.2): a karyos:ipc publication is no network one, so its state is
# KARYOS_ADMISSION_UNKNOWN (0); a null out-parameter answers
# KARYOS_E_INVALID_ARGUMENT with nothing written; a closed publication
# answers KARYOS_E_CLOSED (SPEC.md §10.2, §13).
format 1
id publication.admission.typed.statuses
abi 0.1
covers "typed status codes"

call karyos_driver_create
expect KARYOS_OK driver=$driver
call karyos_driver_add_stream driver=$driver stream_id=7
expect KARYOS_OK
call karyos_driver_start driver=$driver
expect KARYOS_OK
call karyos_driver_connect driver=$driver
expect KARYOS_OK client=$client
call karyos_client_add_publication client=$client stream_id=7
expect KARYOS_OK publication=$publication
call karyos_publication_network_admission publication=$publication
expect KARYOS_OK admission=0
call karyos_publication_network_admission publication=$publication admission=null
expect KARYOS_E_INVALID_ARGUMENT
call karyos_publication_close publication=$publication
expect KARYOS_OK
call karyos_publication_network_admission publication=$publication
expect KARYOS_E_CLOSED
call karyos_client_close client=$client
expect KARYOS_OK
call karyos_driver_close driver=$driver
expect KARYOS_OK
