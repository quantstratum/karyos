# A client's view of a conflation table answers typed statuses (SPEC.md
# §7.1, §10.2, §13; F7b-2c): a channel other than karyos:ipc is
# KARYOS_E_UNSUPPORTED_CHANNEL, and a client of a driver in this process
# is refused by its driver (KARYOS_E_REFUSED), which gives in-process
# views itself (karyos_driver_subscribe_conflated). A failure opens
# nothing.
format 1
id conflated.client.view
abi 0.1
covers "typed status codes"

call karyos_driver_create
expect KARYOS_OK driver=$driver
call karyos_driver_add_stream driver=$driver stream_id=9 conflation_keys=4 conflation_value_capacity=64 conflation_journal_capacity=4096
expect KARYOS_OK
call karyos_driver_start driver=$driver
expect KARYOS_OK
call karyos_driver_connect driver=$driver
expect KARYOS_OK client=$client
call karyos_client_add_conflated_subscription client=$client stream_id=9 uri="karyos:udp?endpoint=127.0.0.1:1"
expect KARYOS_E_UNSUPPORTED_CHANNEL
call karyos_client_add_conflated_subscription client=$client stream_id=9
expect KARYOS_E_REFUSED
call karyos_driver_subscribe_conflated driver=$driver stream_id=9
expect KARYOS_OK conflated=$view
call karyos_conflated_close conflated=$view
expect KARYOS_OK
call karyos_client_close client=$client
expect KARYOS_OK
call karyos_driver_close driver=$driver
expect KARYOS_OK
