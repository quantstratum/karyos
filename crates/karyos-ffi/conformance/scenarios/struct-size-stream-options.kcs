# karyos_stream_options of ABI 0.1.0 is 64 bytes: a smaller size adds no
# stream (KARYOS_E_INVALID_ARGUMENT), and a newer caller's larger struct
# adds the stream its 0.1.0 prefix describes (SPEC.md §10.2, §13, C ABI
# boundary).
format 1
id struct.size.stream.options
abi 0.1
covers "struct sizes of another minor version"

call karyos_driver_create
expect KARYOS_OK driver=$driver
call karyos_driver_add_stream driver=$driver stream_id=7 size=60
expect KARYOS_E_INVALID_ARGUMENT
call karyos_driver_add_stream driver=$driver stream_id=7 size=80
expect KARYOS_OK
# The stream exists once: the newer struct added exactly it.
call karyos_driver_add_stream driver=$driver stream_id=7
expect KARYOS_E_INVALID_ARGUMENT
call karyos_driver_close driver=$driver
expect KARYOS_OK
